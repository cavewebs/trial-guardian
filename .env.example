# Copy to .env and fill in the values you need.
# Do not commit .env.

# --- AI provider (set one, or use --no-ai) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# GOOGLE_AI_API_KEY=your_google_ai_api_key
# GEMINI_MODEL=gemini-1.5-flash

# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: Gmail API OAuth (IMAP app passwords do not need this) ---
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Optional: SMTP notifications ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_smtp_app_password
# SMTP_FROM=you@example.com

# --- Optional: Twilio WhatsApp / SMS ---
# TWILIO_SID=your_twilio_account_sid
# TWILIO_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=+15555555555
# TWILIO_SMS_FROM=+15555555555

# --- Optional: Telegram ---
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- Optional: Slack / Discord (or pass --webhook to the CLI) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/your_webhook_token
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/your_webhook_token

# --- Optional: OpenClaw gateway ---
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token
# OPENCLAW_SESSION_KEY=your_openclaw_session_key

# --- Optional: data directory (default: ~/.trial-guardian) ---
# TRIAL_GUARDIAN_DATA_DIR=/path/to/trial-guardian-data
